# Hydra head endpoints (offline single-node devnet by default)
HYDRA_WS=ws://localhost:4001
HYDRA_HTTP=http://localhost:4001

# --- common knobs (all optional; CLI flags override these) ---
# Target submit rate (tx/s)
BENCH_TPS=20
# Fire-window duration (seconds)
BENCH_DURATION_S=6
# Independent seed lanes (state threads). Keep >= TPS so a lane is revisited only every LANES/TPS >= 1s.
BENCH_LANES=40
# Pre-signed spends per lane. Empty/0 = auto (= ceil(TPS*DURATION/LANES)).
BENCH_CHAIN=
# Trim this fraction off each end of the fire window before computing steady-state P95.
BENCH_WARMUP_FRAC=0.2
# Gate threshold: P95 latency (ms) the run must stay under to PASS.
BENCH_GATE_MS=200
# Closed-loop bound on un-acked in-flight txs. Closed-loop is the DEFAULT because
# open-loop percentiles under saturation are queue time, not service time.
#   auto = calibrate K from a warm-up burst (Little's Law: K ~= confirmTps * target)
#   <n>  = pin K
#   0    = open-loop (fire at fixed cadence, no backpressure) — throughput/knee runs
BENCH_INFLIGHT_MAX=auto
# Latency the auto-calibrator aims at (ms). Defaults to BENCH_GATE_MS.
# BENCH_TARGET_LATENCY_MS=200
# Which ack frees an in-flight slot: txvalid | snapshot
BENCH_INFLIGHT_GATE=txvalid
# --latency mode: which K values to sweep, and how many txs per step.
# BENCH_K_SWEEP=1,2,4,8,16,32,64,128
# BENCH_K_STEP_TXS=200
# Drain grace after the submit window closes (ms).
BENCH_GRACE_MS=20000

# --- where results are filed ---
# Host label for the result tree: results/<node-version>/<BENCH_ENV>/<testcase>/…
# Leave unset — the harness takes it from the running head (infra/state/current.json),
# else from the detected platform. Set it only when the node runs somewhere the
# harness cannot infer, e.g. a remote Linux box: BENCH_ENV=linux-x86_64-native
# BENCH_ENV=
# Escape hatch: dump this run's artifacts to an explicit dir instead of the tree.
# BENCH_OUT_DIR=

# Funding wallet (in-head). Default below matches the offline-devnet pre-funded wallet.
BENCH_MNEMONIC="amount half silver digital green goose loan face blanket slow proof proof unlock pride web drink youth spin state tiny napkin egg slice exhaust"
