# Hydra head endpoints (offline single-node devnet by default)
HYDRA_WS=ws://localhost:4001
HYDRA_HTTP=http://localhost:4001

# --- common knobs (all optional; CLI flags override these) ---
# Target submit rate (tx/s)
BENCH_TPS=20
# Fire-window duration (seconds)
BENCH_DURATION_S=6
# Independent seed lanes (state threads). Keep >= TPS so a lane is revisited only every LANES/TPS >= 1s.
BENCH_LANES=40
# Pre-signed spends per lane. Empty/0 = auto (= ceil(TPS*DURATION/LANES)).
BENCH_CHAIN=
# Trim this fraction off each end of the fire window before computing steady-state P95.
BENCH_WARMUP_FRAC=0.2
# Gate threshold: P95 latency (ms) the run must stay under to PASS.
BENCH_GATE_MS=200
# Closed-loop bound on un-acked in-flight txs (Little's Law K ~= confirmTps * target_latency_s).
# 0 = open-loop (fire at fixed cadence, no backpressure).
BENCH_INFLIGHT_MAX=0
# Which ack frees an in-flight slot: txvalid | snapshot
BENCH_INFLIGHT_GATE=txvalid
# Drain grace after the submit window closes (ms).
BENCH_GRACE_MS=20000

# Funding wallet (in-head). Default below matches the offline-devnet pre-funded wallet.
BENCH_MNEMONIC="amount half silver digital green goose loan face blanket slow proof proof unlock pride web drink youth spin state tiny napkin egg slice exhaust"
